[Unit]
Description=Redis for data lake viewer
After=network-online.target

[Service]
Type=simple
ExecStart=/mnt/projects/jtian15/redis/bin/redis-server --bind 127.0.0.1 --port 6379 --dir /mnt/projects/jtian15/redis-data --appendonly yes --save ""
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
