# Copy this file to .prod.env (gitignored) and fill in real values.
# Used as the docker-compose env_file for the viewer backend.
# All S3_* values are required by the viewer backend.

S3_BUCKET=your-bucket-name
S3_PREFIX=datasets
S3_ENDPOINT_URL=https://s3.example.org/
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Redis — set by docker-compose already; override only for non-compose deployments.
# REDIS_URL=redis://redis:6379/0

# DuckDB cache directory (persistent httpfs cache) — set by docker-compose already.
# DUCKDB_CACHE_DIR=/app/.duckdb

# Optional tuning:
# DUCKDB_POOL_SIZE=4
# DUCKDB_MEMORY_LIMIT=2GB            # DuckDB per-connection memory cap (spills to disk)
# VIEWER_POOL_ACQUIRE_TIMEOUT=30     # seconds before /data returns 503 under load
# VIEWER_NDJSON_QUEUE_SIZE=2         # bounded stream queue (backpressure)
# VIEWER_STREAM_MAX_SECONDS=300      # total NDJSON stream deadline
# ORDERING_TTL=30                    # freshness of materialized filtered orderings
# ORDERING_BUILD_WAIT=5              # wait for another in-process ordering build
# ORDERING_CLEANUP_INTERVAL=300      # expired ordering-file sweep interval
# DUCKDB_CACHE_MAX_BYTES=0           # httpfs cache size cap (0 = disabled)
# VIEWER_WATCHER_INTERVAL=5
# VIEWER_LOG_TIMINGS=0
# VIEWER_CORS_ORIGINS=*
