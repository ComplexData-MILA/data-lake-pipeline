# S3 bucket and prefix for all pipeline data
PIPELINE_S3_URL=s3://my-bucket/data-project/

# Optional: S3 endpoint URL for S3-compatible services (MinIO, DigitalOcean Spaces, etc.)
# PIPELINE_S3_ENDPOINT_URL=http://localhost:9000

# Optional: Explicit S3 credentials (if not using AWS credentials file or IAM role)
# PIPELINE_S3_ACCESS_KEY=your-access-key
# PIPELINE_S3_SECRET_KEY=your-secret-key

# Logging
PIPELINE_LOG_LEVEL=INFO

# Batcher behavior
PIPELINE_STABLE_FILE_AGE_MINUTES=30
PIPELINE_SLURM_ENABLED=false
PIPELINE_SLURM_COMMAND=sbatch
PIPELINE_SLURM_SCRIPT=slurm/slurm_job.sh

# Annotation backend: mock | vllm | sglang
PIPELINE_ANNOTATOR_BACKEND=mock
PIPELINE_MODEL_NAME=Qwen/Qwen3.5-9B-Instruct

# Prompting
PIPELINE_PROMPT_TEMPLATE=Annotate the following post and return a compact JSON object with topic, sentiment, safety_flags, and rationale_short.\n\nPost:\n{text}

# vLLM settings
PIPELINE_VLLM_TENSOR_PARALLEL_SIZE=1
PIPELINE_VLLM_TEMPERATURE=0.1
PIPELINE_VLLM_MAX_TOKENS=256

# Development
PIPELINE_USE_EXAMPLE_SOURCE_DATA=true
